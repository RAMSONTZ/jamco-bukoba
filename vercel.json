{
  "framework": null,
  "installCommand": "npm ci && npm install --no-save --package-lock=false ffmpeg-static@5.3.0 && mkdir -p lib/vendor && cp node_modules/ffmpeg-static/ffmpeg lib/vendor/ffmpeg && chmod +x lib/vendor/ffmpeg",
  "outputDirectory": "public",
  "functions": {
    "api/site.js": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/@spelling-creator/spellophone/{espeak-ng-data,wasm}/**,lib/vendor/ffmpeg}"
    }
  },
  "routes": [
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "/discovery/(.*)\\.webp",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/photos/optimized/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/brand/jamco-logo-display.webp",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/site?__path=/$1"
    }
  ],
  "buildCommand": "env -u VERCEL -u VERCEL_ENV -u DATABASE_URL -u JAMCO_STAGING_DATABASE_URL -u RESEND_API_KEY -u JAMCO_EMAIL_FROM npm test",
  "regions": [
    "fra1"
  ]
}
